<script>
document.addEventListener("DOMContentLoaded", () => {

  lucide.createIcons();

  const cover = document.getElementById("invitation-cover");
  const openButton = document.getElementById("open-invitation");
  const replayButton = document.getElementById("replay-invitation");
  const flowerShower = document.getElementById("flower-shower");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function createFlowerShower() {

    if (reducedMotion) return;

    flowerShower.replaceChildren();
    flowerShower.classList.add("is-active");

    const symbols = ["✿", "❀", "❁", "✦"];
    const totalPetals = 28;

    for (let index = 0; index < totalPetals; index += 1) {

      const petal = document.createElement("span");

      petal.className = index % 5 === 0 ? "petal blossom" : "petal";
      petal.textContent = symbols[index % symbols.length];

      petal.style.left = `${4 + Math.random() * 92}%`;
      petal.style.setProperty("--drift", `${-100 + Math.random() * 200}px`);
      petal.style.setProperty("--fall-duration", `${1.8 + Math.random() * 1.6}s`);
      petal.style.setProperty("--fall-delay", `${Math.random() * .45}s`);

      flowerShower.appendChild(petal);
    }

    window.setTimeout(() => {
      flowerShower.classList.remove("is-active");
      flowerShower.replaceChildren();
    }, 3600);
  }


  function openInvitation() {

    createFlowerShower();

    cover.classList.add("is-open");

    window.setTimeout(() => {
      document.getElementById("main-content").focus({
        preventScroll: true
      });
    }, reducedMotion ? 0 : 850);

  }


  function replayInvitation() {

    flowerShower.classList.remove("is-active");
    flowerShower.replaceChildren();

    cover.classList.remove("is-open");

    openButton.focus();

  }


  openButton.addEventListener("click", openInvitation);
  replayButton.addEventListener("click", replayInvitation);


  const menuButton = document.getElementById("menu-button");
  const mobileNavigation = document.getElementById("mobile-navigation");


  menuButton.addEventListener("click", () => {

    const opening = mobileNavigation.classList.contains("hidden");

    mobileNavigation.classList.toggle("hidden", !opening);

    menuButton.setAttribute("aria-expanded", String(opening));

  });


  mobileNavigation.querySelectorAll("a").forEach((link) => {

    link.addEventListener("click", () => {

      mobileNavigation.classList.add("hidden");

      menuButton.setAttribute("aria-expanded", "false");

    });

  });


  if (!reducedMotion && "IntersectionObserver" in window) {

    const observer = new IntersectionObserver((entries) => {

      entries.forEach((entry) => {

        if (entry.isIntersecting) {

          entry.target.classList.add("is-visible");

          observer.unobserve(entry.target);

        }

      });

    }, {
      threshold: 0.12
    });


    document.querySelectorAll(".reveal").forEach((element) => {
      observer.observe(element);
    });

  } else {

    document.querySelectorAll(".reveal").forEach((element) => {
      element.classList.add("is-visible");
    });

  }

});
</script>

